  /// Saturation / brightness filter for the dimmed room (v = 0..1).
  static List<double> _dimMatrix(double v) {
    final sat = 1 - 0.55 * v;
    final b = 1 - 0.4 * v;
    const lr = 0.2126, lg = 0.7152, lb = 0.0722;
    final i = 1 - sat;
    return [
      (lr * i + sat) * b, lg * i * b, lb * i * b, 0, 0, //
      lr * i * b, (lg * i + sat) * b, lb * i * b, 0, 0, //
      lr * i * b, lg * i * b, (lb * i + sat) * b, 0, 0, //
      0, 0, 0, 1, 0, //
    ];
  }

  /// Design px → canvas px (stage fit + the shell's zoom / pan), and the
  /// combined scale.
  ({Offset Function(Offset) map, double k}) _stageMapper(Size canvas) {
    final fit = math.min(canvas.width / _design.width, canvas.height / _design.height);
    final origin = Offset((canvas.width - _design.width * fit) / 2, (canvas.height - _design.height * fit) / 2);
    final m = _lab.transform.value;
    return (map: (d) => MatrixUtils.transformPoint(m, origin + d * fit), k: fit * m.getMaxScaleOnAxis());
  }

