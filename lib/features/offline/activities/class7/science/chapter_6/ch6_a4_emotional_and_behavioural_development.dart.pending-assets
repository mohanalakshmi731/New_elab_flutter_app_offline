  /// One draggable icon (HTML `.draggable-icon`): drag it onto the avatar
  /// or tap it (the HTML "click-to-auto-drop").
  Widget _activityTile(_Activity a, LabPalette p, double s, {required bool cue}) {
    final allowed = _canUse(a);
    final dark = _lab.isDark;
    final icon = cue
        ? ValueListenableBuilder<double>(
            valueListenable: _frame,
            builder: (context, t, _) => _tileIcon(a, s, glow: 0.5 + 0.5 * math.sin(t * 4)),
          )
        : _tileIcon(a, s);
    final body = Column(
      mainAxisSize: MainAxisSize.min,
      children: [
        icon,
        SizedBox(height: 4 * s),
        Text(
          _t(_activityKey[a]!),
          textAlign: TextAlign.center,
          style: TextStyle(
            color: dark ? _Colors.slate300 : _Colors.slate600,
            fontSize: 11 * s,
            fontWeight: FontWeight.w700,
          ),
        ),
      ],
    );
    final half = 27 * s * 1.2;
    return Listener(
      onPointerDown: allowed ? null : (_) => _rejectActivity(a),
      child: Draggable<_Activity>(
        data: a,
        maxSimultaneousDrags: allowed ? 1 : 0,
        dragAnchorStrategy: pointerDragAnchorStrategy,
        feedback: Material(
          type: MaterialType.transparency,
          child: Transform.translate(
            offset: Offset(-half, -half),
            child: Transform.scale(scale: 1.2, alignment: Alignment.topLeft, child: _tileIcon(a, s, lifted: true)),
          ),
        ),
        childWhenDragging: Opacity(opacity: 0.3, child: body),
        onDragStarted: () {
          _Audio.play(_Sound.pickup);
          setState(() => _scene.dragging = a);
        },
        onDragEnd: (_) {
          if (mounted && _scene.dragging != null) setState(() => _scene.dragging = null);
        },
        onDraggableCanceled: (_, _) {
          if (mounted) _lab.showToast(_t('msg_drop_on_avatar'), isError: true);
        },
        child: GestureDetector(
          behavior: HitTestBehavior.opaque,
          onTap: allowed ? () => _dropActivity(a) : null,
          child: body,
        ),
      ),
    );
  }

