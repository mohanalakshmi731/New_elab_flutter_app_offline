  /// HTML `#mean-comment`: fades (ignore) or explodes (adult).
  Widget _meanComment(double s, Color text) {
    final dark = _lab.isDark;
    final sc = _scene;
    final row = Row(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _faceCircle(_Face.devil, _Colors.red100, 30 * s),
        SizedBox(width: 8 * s),
        Flexible(
          child: Container(
            padding: EdgeInsets.symmetric(horizontal: 10 * s, vertical: 8 * s),
            decoration: BoxDecoration(
              color: dark ? _Colors.slate800 : _Colors.slate100,
              borderRadius: BorderRadius.only(
                topLeft: Radius.circular(4 * s),
                topRight: Radius.circular(16 * s),
                bottomLeft: Radius.circular(16 * s),
                bottomRight: Radius.circular(16 * s),
              ),
              border: Border.all(color: dark ? _Colors.slate700 : _Colors.slate200),
            ),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  _t('lbl_bully_name'),
                  style: TextStyle(color: _Colors.red500, fontWeight: FontWeight.w800, fontSize: 10 * s),
                ),
                SizedBox(height: 2 * s),
                Text(
                  _t('txt_mean_comment'),
                  style: TextStyle(color: text, fontSize: 12 * s, height: 1.35),
                ),
              ],
            ),
          ),
        ),
      ],
    );
    final faded = AnimatedOpacity(
      opacity: sc.mean == _MeanState.fading ? 0 : 1,
      duration: const Duration(milliseconds: 500),
      child: row,
    );
    if (sc.mean != _MeanState.exploding) return faded;
    // HTML `.animate-explode` plus a puff of smoke.
    return TweenAnimationBuilder<double>(
      tween: Tween(begin: 0, end: 1),
      duration: const Duration(milliseconds: 600),
      builder: (context, v, child) {
        final scale = v < 0.5 ? 1 + v : 1.5 * (1 - (v - 0.5) * 2);
        final opacity = v < 0.5 ? 1 - v : 1 - v;
        return Stack(
          clipBehavior: Clip.none,
          children: [
            Opacity(
              opacity: opacity.clamp(0.0, 1.0),
              child: Transform.scale(scale: math.max(scale, 0.001), child: child),
            ),
            Positioned.fill(child: CustomPaint(painter: _PuffPainter(v, dark))),
          ],
        );
      },
      child: faded,
    );
  }

  /// One of the three angry replies (HTML `.animate-angry-pop`).
  Widget _angryReply(int i, double s, Color text) {
    final dark = _lab.isDark;
    return TweenAnimationBuilder<double>(
      key: ValueKey('angry-$i'),
      tween: Tween(begin: 0, end: 1),
      duration: const Duration(milliseconds: 400),
      builder: (context, v, child) {
        double scale, dy, opacity;
        if (v < 0.7) {
          final u = v / 0.7;
          scale = 1.2 * u;
          dy = 20 - 25 * u;
          opacity = u;
        } else {
          final u = (v - 0.7) / 0.3;
          scale = 1.2 - 0.2 * u;
          dy = -5 + 5 * u;
          opacity = 1;
        }
        return Opacity(
          opacity: opacity,
          child: Transform.translate(
            offset: Offset(0, dy * s),
            child: Transform.scale(scale: math.max(scale, 0.001), alignment: Alignment.centerRight, child: child),
          ),
        );
      },
      child: Row(
        mainAxisAlignment: MainAxisAlignment.end,
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Flexible(
            child: Container(
              padding: EdgeInsets.symmetric(horizontal: 10 * s, vertical: 8 * s),
