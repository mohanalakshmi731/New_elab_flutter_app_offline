/// Confetti pieces in canvas space (HTML `canvas-confetti`).
class _ConfettiPainter extends CustomPainter {
  _ConfettiPainter({required this.scene, required Listenable repaint}) : super(repaint: repaint);

  final _MoodScene scene;

  @override
  void paint(Canvas canvas, Size size) {
    if (scene.confetti.isEmpty) return;
    final t = scene.time;
    final h = size.height;
    const k = 2.3; // air drag
    const g = 1.3; // gravity, canvas heights / s²
    final paint = Paint();
    for (final c in scene.confetti) {
      final a = t - c.born;
      if (a < 0 || a > 3.3) continue;
      final e = 1 - math.exp(-k * a);
      final x = c.origin.dx * size.width + c.vx / k * e * h + math.sin(a * 5 + c.phase) * 8;
      final y = c.origin.dy * h + (g / k * a + (c.vy - g / k) / k * e) * h;
      final alpha = a < 2.5 ? 1.0 : (1 - (a - 2.5) / 0.8).clamp(0.0, 1.0);
      canvas.save();
      canvas.translate(x, y);
      canvas.rotate(c.phase + c.spin * a);
      canvas.scale(1, math.cos(a * c.flip + c.phase).abs().clamp(0.15, 1.0));
      paint.color = c.color.withValues(alpha: alpha);
      canvas.drawRect(Rect.fromCenter(center: Offset.zero, width: 10 * c.size, height: 6 * c.size), paint);
      canvas.restore();
    }
  }

  @override
  bool shouldRepaint(covariant _ConfettiPainter old) => false;
}

/// Scenario 2 background behind the feed: theme colour (HTML
/// `scene.background`) with soft drifting social-media symbols.
class _FeedBackdropPainter extends CustomPainter {
  _FeedBackdropPainter({required this.scene, required Listenable repaint, required this.isDark})
    : super(repaint: repaint);

  final _MoodScene scene;
  final bool isDark;

  @override
  void paint(Canvas canvas, Size size) {
    final bleed = labBleed(size);
    canvas.drawRect(bleed, Paint()..color = isDark ? _Colors.slate900 : _Colors.sky100);
    final glow = Rect.fromCenter(center: Offset(size.width / 2, size.height * 0.45), width: 1400, height: 1000);
    canvas.drawRect(
      bleed,
      Paint()
        ..shader = RadialGradient(
          colors: isDark ? const [Color(0x402563EB), Color(0x000F172A)] : const [Color(0xB3FFFFFF), Color(0x00E0F2FE)],
        ).createShader(glow),
    );
    final t = scene.time;
    const colors = [_Colors.pink400, _Colors.blue400, _Colors.amber400, _Colors.emerald400];
    for (var i = 0; i < 18; i++) {
      final speed = 9 + (i % 5) * 4.0;
      final x = -180 + (i * 263.7) % 1360 + math.sin(t * 0.5 + i) * 14;
      final y = 760 - (t * speed + i * 151.3) % 960;
      final r = 16 + (i % 4) * 7.0;
      final color = colors[i % colors.length].withValues(alpha: isDark ? 0.13 : 0.22);
      final c = Offset(x, y);
      switch (i % 3) {
        case 0:
          _heart(canvas, c, r, color);
        case 1:
          _chat(canvas, c, r, color);
        default:
          _smile(canvas, c, r, color);
      }
    }
  }

  void _heart(Canvas canvas, Offset c, double r, Color color) {
    final p = Path()
      ..moveTo(c.dx, c.dy + 0.8 * r)
      ..cubicTo(c.dx - 1.3 * r, c.dy - 0.1 * r, c.dx - 0.7 * r, c.dy - 1.3 * r, c.dx, c.dy - 0.5 * r)
      ..cubicTo(c.dx + 0.7 * r, c.dy - 1.3 * r, c.dx + 1.3 * r, c.dy - 0.1 * r, c.dx, c.dy + 0.8 * r)
      ..close();
    canvas.drawPath(p, Paint()..color = color);
  }

  void _chat(Canvas canvas, Offset c, double r, Color color) {
    final body = RRect.fromRectAndRadius(
      Rect.fromCenter(center: c, width: 2.2 * r, height: 1.5 * r),
      Radius.circular(0.5 * r),
    );
    final p = Path()
      ..addRRect(body)
      ..moveTo(c.dx - 0.5 * r, c.dy + 0.6 * r)
      ..lineTo(c.dx - 0.75 * r, c.dy + 1.2 * r)
      ..lineTo(c.dx - 0.05 * r, c.dy + 0.7 * r)
      ..close();
    canvas.drawPath(p, Paint()..color = color);
  }

  void _smile(Canvas canvas, Offset c, double r, Color color) {
    final stroke = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = 0.18 * r
      ..strokeCap = StrokeCap.round
      ..color = color;
    canvas.drawCircle(c, r, stroke);
    canvas.drawArc(Rect.fromCircle(center: c, radius: 0.55 * r), 0.35, math.pi - 0.7, false, stroke);
    canvas.drawCircle(c + Offset(-0.35 * r, -0.3 * r), 0.12 * r, Paint()..color = color);
    canvas.drawCircle(c + Offset(0.35 * r, -0.3 * r), 0.12 * r, Paint()..color = color);
  }

  @override
  bool shouldRepaint(covariant _FeedBackdropPainter old) => old.isDark != isDark;
}

/// The post picture: the HTML's floating yellow smiley SVG (viewBox 200).
class _SmileyPostPainter extends CustomPainter {
  _SmileyPostPainter({required this.scene, required Listenable repaint}) : super(repaint: repaint);

  final _MoodScene scene;

  @override
  void paint(Canvas canvas, Size size) {
    final side = math.min(size.width, size.height) - 16;
    if (side <= 0) return;
    final k = side / 200;
    // @keyframes f: 0/100% rest, 50% translateY(-10px) rotate(5deg), 3 s.
    final v = 0.5 - 0.5 * math.cos((scene.time % 3) / 3 * 2 * math.pi);
    canvas.save();
    canvas.translate(size.width / 2, size.height / 2);
    canvas.scale(k);
    canvas.translate(0, -10 * v);
    canvas.rotate(5 * math.pi / 180 * v);
    canvas.drawCircle(Offset.zero, 80, Paint()..color = const Color(0xFFFFD93D));
    canvas.drawCircle(
      Offset.zero,
      80,
      Paint()
        ..style = PaintingStyle.stroke
        ..strokeWidth = 4
        ..color = const Color(0xFFE5B300),
    );
    final ink = Paint()
      ..style = PaintingStyle.stroke
      ..strokeCap = StrokeCap.round
      ..color = const Color(0xFF4A4A4A);
    canvas.drawPath(
      Path()
        ..moveTo(-30, 20)
        ..quadraticBezierTo(0, 50, 30, 20),
      ink..strokeWidth = 8,
    );
    ink.strokeWidth = 6;
    canvas.drawPath(
      Path()
        ..moveTo(-35, -15)
        ..quadraticBezierTo(-25, -25, -15, -15),
      ink,
    );
    canvas.drawPath(
      Path()
        ..moveTo(15, -15)
        ..quadraticBezierTo(25, -25, 35, -15),
      ink,
    );
    canvas.restore();
  }

  @override
  bool shouldRepaint(covariant _SmileyPostPainter old) => false;
}

/// Smoke puff around the exploding mean comment ([v] = 0..1).
class _PuffPainter extends CustomPainter {
  const _PuffPainter(this.v, this.isDark);

  final double v;
  final bool isDark;

  @override
  void paint(Canvas canvas, Size size) {
    if (v < 0.25) return;
    final u = (v - 0.25) / 0.75;
    final c = size.center(Offset.zero);
    final base = math.min(size.width, size.height);
    final paint = Paint()
      ..color = (isDark ? _Colors.slate300 : _Colors.slate400).withValues(alpha: 0.6 * (1 - u))
      ..maskFilter = MaskFilter.blur(BlurStyle.normal, base * 0.12);
    for (var i = 0; i < 9; i++) {
      final a = i / 9 * 2 * math.pi + 0.4;
      final d = base * (0.2 + 0.7 * u) * (i.isEven ? 1 : 0.7);
      final p = c + Offset(math.cos(a) * d * 2.2, math.sin(a) * d * 0.8 - base * 0.2 * u);
      canvas.drawCircle(p, base * (0.18 + 0.22 * u), paint);
    }
  }

  @override
  bool shouldRepaint(covariant _PuffPainter old) => old.v != v || old.isDark != isDark;
}

/// Faces drawn instead of the HTML emoji, filling the given box.
class _FacePainter extends CustomPainter {
  const _FacePainter(this.face);

  final _Face face;

  @override
  void paint(Canvas canvas, Size size) {
    final r = size.shortestSide / 2;
    final c = size.center(Offset.zero);
    switch (face) {
      case _Face.neutral:
        _ball(canvas, c, r, const Color(0xFFFFD93D), const Color(0xFFF59E0B));
        const ink = Color(0xFF5B3A00);
        for (final sx in [-1.0, 1.0]) {
          canvas.drawOval(
            Rect.fromCenter(center: c + Offset(sx * 0.33 * r, -0.12 * r), width: 0.17 * r, height: 0.3 * r),
            Paint()..color = ink,
          );
        }
        canvas.drawLine(c + Offset(-0.36 * r, 0.4 * r), c + Offset(0.36 * r, 0.4 * r), _stroke(ink, 0.12 * r));
      case _Face.angry:
        _ball(canvas, c, r, const Color(0xFFFB923C), const Color(0xFFDC2626));
        const ink = Color(0xFF450A0A);
        final brow = _stroke(ink, 0.13 * r);
        canvas.drawLine(c + Offset(-0.6 * r, -0.42 * r), c + Offset(-0.12 * r, -0.16 * r), brow);
        canvas.drawLine(c + Offset(0.6 * r, -0.42 * r), c + Offset(0.12 * r, -0.16 * r), brow);
        canvas.drawCircle(c + Offset(-0.3 * r, 0.02 * r), 0.1 * r, Paint()..color = ink);
        canvas.drawCircle(c + Offset(0.3 * r, 0.02 * r), 0.1 * r, Paint()..color = ink);
        canvas.drawPath(
          Path()
            ..moveTo(c.dx - 0.36 * r, c.dy + 0.55 * r)
            ..quadraticBezierTo(c.dx, c.dy + 0.22 * r, c.dx + 0.36 * r, c.dy + 0.55 * r),
          _stroke(ink, 0.12 * r),
        );
      case _Face.devil:
        const horn = Color(0xFF6D28D9);
        for (final sx in [-1.0, 1.0]) {
          canvas.drawPath(
            Path()
              ..moveTo(c.dx + sx * 0.78 * r, c.dy - 0.4 * r)
              ..quadraticBezierTo(c.dx + sx * 1.0 * r, c.dy - 0.95 * r, c.dx + sx * 0.62 * r, c.dy - 1.08 * r)
              ..quadraticBezierTo(c.dx + sx * 0.66 * r, c.dy - 0.82 * r, c.dx + sx * 0.32 * r, c.dy - 0.78 * r)
              ..close(),
            Paint()..color = horn,
          );
        }
        _ball(canvas, c, r * 0.94, const Color(0xFFA78BFA), const Color(0xFF6D28D9));
        const ink = Color(0xFF2E1065);
        final brow = _stroke(ink, 0.11 * r);
        canvas.drawLine(c + Offset(-0.55 * r, -0.36 * r), c + Offset(-0.14 * r, -0.16 * r), brow);
        canvas.drawLine(c + Offset(0.55 * r, -0.36 * r), c + Offset(0.14 * r, -0.16 * r), brow);
        canvas.drawCircle(c + Offset(-0.3 * r, -0.02 * r), 0.09 * r, Paint()..color = ink);
        canvas.drawCircle(c + Offset(0.3 * r, -0.02 * r), 0.09 * r, Paint()..color = ink);
        canvas.drawPath(
          Path()
            ..moveTo(c.dx - 0.45 * r, c.dy + 0.22 * r)
            ..quadraticBezierTo(c.dx, c.dy + 0.8 * r, c.dx + 0.45 * r, c.dy + 0.22 * r)
            ..quadraticBezierTo(c.dx, c.dy + 0.42 * r, c.dx - 0.45 * r, c.dy + 0.22 * r)
            ..close(),
          Paint()..color = ink,
        );
      case _Face.happy:
        const ink = _Colors.green600;
        canvas.drawCircle(c, 0.84 * r, _stroke(ink, 0.13 * r));
        canvas.drawCircle(c + Offset(-0.3 * r, -0.16 * r), 0.1 * r, Paint()..color = ink);
        canvas.drawCircle(c + Offset(0.3 * r, -0.16 * r), 0.1 * r, Paint()..color = ink);
        canvas.drawPath(
          Path()
            ..moveTo(c.dx - 0.42 * r, c.dy + 0.16 * r)
            ..quadraticBezierTo(c.dx, c.dy + 0.66 * r, c.dx + 0.42 * r, c.dy + 0.16 * r),
          _stroke(ink, 0.13 * r),
        );
      case _Face.teacher:
        _teacher(canvas, c, r);
    }
  }

  Paint _stroke(Color color, double width) => Paint()
    ..style = PaintingStyle.stroke
    ..strokeWidth = width
    ..strokeCap = StrokeCap.round
    ..color = color;

  void _ball(Canvas canvas, Offset c, double r, Color top, Color bottom) {
    canvas.drawCircle(
      c,
      r,
      Paint()
        ..shader = RadialGradient(
          center: const Alignment(-0.3, -0.4),
          colors: [labShade(top, 0.3), top, bottom],
          stops: const [0, 0.55, 1],
        ).createShader(Rect.fromCircle(center: c, radius: r)),
    );
    canvas.drawCircle(c, r * 0.97, _stroke(labShade(bottom, -0.2), r * 0.06));
  }

  /// A friendly teacher bust (the HTML 👨‍🏫).
  void _teacher(Canvas canvas, Offset c, double r) {
    const skin = Color(0xFFF2C28B);
    // Jacket and shirt collar.
    canvas.drawPath(
      Path()
        ..moveTo(c.dx - 1.0 * r, c.dy + 1.05 * r)
        ..quadraticBezierTo(c.dx - 0.9 * r, c.dy + 0.42 * r, c.dx - 0.28 * r, c.dy + 0.36 * r)
        ..lineTo(c.dx + 0.28 * r, c.dy + 0.36 * r)
        ..quadraticBezierTo(c.dx + 0.9 * r, c.dy + 0.42 * r, c.dx + 1.0 * r, c.dy + 1.05 * r)
        ..close(),
      Paint()..color = _Colors.slate700,
    );
    canvas.drawRect(
      Rect.fromCenter(center: c + Offset(0, 0.3 * r), width: 0.26 * r, height: 0.2 * r),
      Paint()..color = skin,
    );
    canvas.drawPath(
      Path()
        ..moveTo(c.dx - 0.26 * r, c.dy + 0.36 * r)
        ..lineTo(c.dx, c.dy + 0.74 * r)
        ..lineTo(c.dx + 0.26 * r, c.dy + 0.36 * r)
        ..close(),
      Paint()..color = Colors.white,
    );
    canvas.drawPath(
      Path()
        ..moveTo(c.dx - 0.07 * r, c.dy + 0.42 * r)
        ..lineTo(c.dx + 0.07 * r, c.dy + 0.42 * r)
        ..lineTo(c.dx + 0.1 * r, c.dy + 0.72 * r)
        ..lineTo(c.dx, c.dy + 0.82 * r)
        ..lineTo(c.dx - 0.1 * r, c.dy + 0.72 * r)
        ..close(),
      Paint()..color = _Colors.emerald500,
    );
    // Head, hair, glasses, smile.
    final head = c + Offset(0, -0.14 * r);
    final hr = 0.42 * r;
    canvas.drawCircle(
      head,
      hr,
      Paint()
        ..shader = RadialGradient(
          center: const Alignment(-0.3, -0.3),
          colors: [labShade(skin, 0.2), skin, labShade(skin, -0.15)],
        ).createShader(Rect.fromCircle(center: head, radius: hr)),
    );
    canvas.drawPath(
      Path()
        ..moveTo(head.dx - hr * 1.02, head.dy + 0.05 * hr)
        ..arcToPoint(Offset(head.dx + hr * 1.02, head.dy + 0.05 * hr), radius: Radius.circular(hr * 1.02))
        ..quadraticBezierTo(head.dx + 0.3 * hr, head.dy - 0.55 * hr, head.dx - hr * 1.02, head.dy + 0.05 * hr)
        ..close(),
      Paint()..color = const Color(0xFF4A2C17),
    );
    const ink = Color(0xFF1F2937);
    final frame = _stroke(ink, 0.05 * r);
    canvas.drawCircle(head + Offset(-0.38 * hr, 0.18 * hr), 0.25 * hr, frame);
    canvas.drawCircle(head + Offset(0.38 * hr, 0.18 * hr), 0.25 * hr, frame);
    canvas.drawLine(head + Offset(-0.13 * hr, 0.18 * hr), head + Offset(0.13 * hr, 0.18 * hr), frame);
    canvas.drawCircle(head + Offset(-0.38 * hr, 0.2 * hr), 0.07 * hr, Paint()..color = ink);
    canvas.drawCircle(head + Offset(0.38 * hr, 0.2 * hr), 0.07 * hr, Paint()..color = ink);
    canvas.drawPath(
      Path()
        ..moveTo(head.dx - 0.32 * hr, head.dy + 0.55 * hr)
        ..quadraticBezierTo(head.dx, head.dy + 0.82 * hr, head.dx + 0.32 * hr, head.dy + 0.55 * hr),
      _stroke(const Color(0xFF7C2D12), 0.06 * r),
    );
  }

  @override
  bool shouldRepaint(covariant _FacePainter old) => old.face != face;
}

/// The HTML's 24×24 SVG icons (music, soccer ball, phone, reactions).
class _GlyphPainter extends CustomPainter {
  const _GlyphPainter(this.glyph, {this.color = _Colors.blue500, this.secondary = _Colors.slate50});

  final _Glyph glyph;
  final Color color;

  /// The small side figures of "Tell Adult" (`#f8fafc` in the HTML).
  final Color secondary;

  static const Color _light = _Colors.slate300; // #cbd5e1
  static const Color _white = _Colors.slate50; // #f8fafc

  @override
  void paint(Canvas canvas, Size size) {
    final k = math.min(size.width, size.height) / 24;
    canvas.save();
    canvas.translate((size.width - 24 * k) / 2, (size.height - 24 * k) / 2);
    canvas.scale(k);
    final fill = Paint()..color = color;
    switch (glyph) {
      case _Glyph.music:
        Path beam() => Path()
          ..moveTo(15, 18)
          ..lineTo(15, 5.514)
          ..arcToPoint(const Offset(14.447, 4.62), radius: const Radius.circular(1), clockwise: false)
          ..lineTo(8.447, 1.62)
          ..arcToPoint(const Offset(7, 2.514), radius: const Radius.circular(1), clockwise: false)
          ..lineTo(7, 15);
        canvas.drawPath(beam()..close(), Paint()..color = _light);
        canvas.drawCircle(const Offset(12, 18), 3, fill);
        canvas.drawPath(
          beam()
            ..arcToPoint(const Offset(9, 17.82), radius: const Radius.circular(3), largeArc: true, clockwise: false)
            ..lineTo(9, 8.118)
            ..lineTo(13, 10.118)
            ..lineTo(13, 15.178)
            ..arcToPoint(const Offset(15, 18), radius: const Radius.circular(3.001), clockwise: false)
            ..close(),
          fill,
        );
      case _Glyph.sports:
        canvas.drawCircle(const Offset(12, 12), 10, Paint()..color = _light);
        final star = Path()
          ..moveTo(12, 2)
          ..lineTo(13.54, 7)
          ..lineTo(18, 7)
          ..lineTo(13.73, 10.46)
          ..lineTo(15.27, 15.46)
          ..lineTo(12, 12)
          ..lineTo(7.19, 15.46)
          ..lineTo(8.73, 10.46)
          ..lineTo(4.5, 7)
          ..lineTo(9, 7)
          ..lineTo(10.54, 2)
          ..close();
        final inner = Path()
          ..moveTo(8.2, 8.5)
          ..lineTo(12, 10.24)
          ..lineTo(15.8, 8.5)
          ..lineTo(14.27, 13.5)
          ..lineTo(10.47, 10.76)
          ..lineTo(6.67, 13.5)
          ..close();
        canvas.drawPath(star, fill);
        canvas.drawPath(inner, fill);
        canvas.drawPath(
          star,
          Paint()
            ..style = PaintingStyle.stroke
            ..strokeWidth = 0.5
            ..color = color,
        );
      case _Glyph.phone:
        canvas.drawRRect(RRect.fromLTRBR(6, 3, 18, 21, const Radius.circular(2)), fill);
        canvas.drawRRect(RRect.fromLTRBR(7, 4, 17, 18, const Radius.circular(1)), Paint()..color = _light);
        canvas.drawLine(
          const Offset(9, 20),
          const Offset(15, 20),
          Paint()
            ..strokeWidth = 2
            ..strokeCap = StrokeCap.round
            ..color = color,
        );
      case _Glyph.retaliate:
      case _Glyph.ignore:
        canvas.drawCircle(const Offset(12, 12), 10, fill);
        canvas.drawCircle(const Offset(9, 10), 1.5, Paint()..color = _white);
        canvas.drawCircle(const Offset(15, 10), 1.5, Paint()..color = _white);
        final mouth = Paint()
          ..style = PaintingStyle.stroke
          ..strokeWidth = 2
          ..strokeCap = StrokeCap.round
          ..color = _white;
        if (glyph == _Glyph.retaliate) {
          canvas.drawPath(
            Path()
              ..moveTo(7, 16)
              ..cubicTo(8.5, 14, 10, 13, 12, 13)
              ..cubicTo(14, 13, 15.5, 14, 17, 16),
            mouth,
          );
        } else {
          canvas.drawLine(const Offset(7, 16), const Offset(17, 16), mouth);
        }
      case _Glyph.adult:
        canvas.drawCircle(const Offset(12, 4), 2, fill);
        canvas.drawPath(
          Path()
            ..moveTo(12, 8)
            ..cubicTo(9.79, 8, 8, 9.79, 8, 12)
            ..lineTo(8, 19)
            ..lineTo(10, 19)
            ..lineTo(10, 15)
            ..lineTo(14, 15)
            ..lineTo(14, 19)
            ..lineTo(16, 19)
            ..lineTo(16, 12)
            ..cubicTo(16, 9.79, 14.21, 8, 12, 8)
            ..close(),
          fill,
        );
        final side = Paint()..color = secondary;
        for (final cx in [6.0, 18.0]) {
          canvas.drawCircle(Offset(cx, 11.5), 1.5, side);
          canvas.drawPath(
            Path()
              ..moveTo(cx, 14)
              ..cubicTo(cx - 1.66, 14, cx - 3, 15.34, cx - 3, 17)
              ..lineTo(cx - 3, 21)
              ..lineTo(cx - 1.5, 21)
              ..lineTo(cx - 1.5, 18)
              ..lineTo(cx + 1.5, 18)
              ..lineTo(cx + 1.5, 21)
              ..lineTo(cx + 3, 21)
              ..lineTo(cx + 3, 17)
              ..cubicTo(cx + 3, 15.34, cx + 1.66, 14, cx, 14)
              ..close(),
            side,
          );
        }
    }
    canvas.restore();
  }

  @override
  bool shouldRepaint(covariant _GlyphPainter old) =>
      old.glyph != glyph || old.color != color || old.secondary != secondary;
}

