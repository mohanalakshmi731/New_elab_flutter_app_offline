class _Ch6A4EmotionalAndBehaviouralDevelopmentPageState extends State<Ch6A4EmotionalAndBehaviouralDevelopmentPage>
    with TickerProviderStateMixin {
  final LabController _lab = LabController(style: _style, camLocked: true);
  final _MoodScene _scene = _MoodScene();
  final ValueNotifier<double> _frame = ValueNotifier(0);
  final ScrollController _feedScroll = ScrollController();
  final GlobalKey _stageKey = GlobalKey();
  final math.Random _rng = math.Random(6);

  late final Ticker _ticker;

  /// Room lighting dims and colours fade after "Isolate" (HTML light tween).
  late final AnimationController _dim = AnimationController(vsync: this, duration: const Duration(milliseconds: 1000));

  bool _precached = false;
  int _thoughtGen = 0;

  int get _scenario => _scene.scenario;
  int get _step => _scene.step;

  String _t(String key) => _lab.tr(_i18n, key);
  LabScenarioData get _data => _scenarios[_lab.lang.code]![_scenario];

  @override
  void initState() {
    super.initState();
    SystemChrome.setPreferredOrientations([DeviceOrientation.landscapeLeft, DeviceOrientation.landscapeRight]);
    SystemChrome.setEnabledSystemUIMode(SystemUiMode.immersive);

    _ticker = createTicker((elapsed) {
      final t = elapsed.inMicroseconds / 1e6;
      _scene.time = t;
      _scene.notes.removeWhere((n) => t - n.born > 3.4);
      _scene.rings.removeWhere((r) => t - r.born > 0.8);
      _scene.confetti.removeWhere((c) => t - c.born > 3.4);
      _frame.value = t;
    })..start();
  }

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    if (_precached) return;
    _precached = true;
    // All four pictures are decoded up front so mood changes cross-fade
    // without a blank frame.
    for (final path in _moodImage.values) {
      unawaited(precacheImage(AssetImage(path), context));
    }
  }

  @override
  void dispose() {
    SystemChrome.setPreferredOrientations([DeviceOrientation.portraitUp, DeviceOrientation.portraitDown]);
    SystemChrome.setEnabledSystemUIMode(SystemUiMode.edgeToEdge);
    _ticker.dispose();
    _dim.dispose();
    _feedScroll.dispose();
    _frame.dispose();
    _lab.dispose();
    super.dispose();
  }

  // ------------------------------------------------------------ logic

  /// HTML `resetScenarioState()`: cancels timers, clears the scene.
  void _resetScene() {
    _lab.cancelPending();
    _thoughtGen++;
    _dim.stop();
    _dim.value = 0;
    _scene.reset();
    if (_feedScroll.hasClients) _feedScroll.jumpTo(0);
    _lab.resetView(sound: false);
  }

  void _changeScenario(int index) {
    setState(() {
      _scene.scenario = index;
      _scene.step = 1;
      _lab.hidePopup(sound: false);
      _resetScene();
    });
    if (index == 1) _scrollFeedToEnd();
  }

  void _fullReset() {
    setState(() {
      _scene.scenario = 0;
      _scene.step = 1;
      _resetScene();
    });
  }

  /// HTML `triggerConclusionState()`: shows "Review Findings".
  void _conclusionState() {
    _Audio.play(_Sound.success);
    setState(() => _scene.reviewVisible = true);
  }

  /// HTML `triggerConclusion()`: summary popup with confetti.
  void _triggerConclusion() {
    if (!_scene.reviewVisible) return;
    final sc = _scenario;
    setState(() {
      _scene.reviewVisible = false;
      _scene.reviewed = true;
    });
    _burst(const Offset(0.5, 0.3), 150, const [_Colors.blue500, _Colors.blue600, _Colors.blue400]);
    _lab.showScenarioConclusion(
      scenarioIndex: sc,
      totalScenarios: 2,
      title: () => _t('success'),
      heading: () => _t('discovery_complete'),
      body: () => _t('summary_${sc + 1}'),
      extra: () => sc == 0 ? _summaryMoods() : _summaryReactions(),
      delay: const Duration(milliseconds: 300),
    );
  }

  /// Confetti from [origin] (fraction of the canvas), like `confetti()`.
  void _burst(Offset origin, int count, List<Color> colors) {
    final t = _scene.time;
    for (var i = 0; i < count; i++) {
      final angle = -math.pi / 2 + (_rng.nextDouble() - 0.5) * 70 * math.pi / 180;
      final speed = 1.0 + _rng.nextDouble() * 0.8;
      _scene.confetti.add(
        _Confetti(
          origin: origin,
          vx: math.cos(angle) * speed,
          vy: math.sin(angle) * speed,
          color: colors[i % colors.length],
          born: t + _rng.nextDouble() * 0.06,
          spin: (_rng.nextDouble() - 0.5) * 12,
          phase: _rng.nextDouble() * math.pi * 2,
          flip: 4 + _rng.nextDouble() * 8,
          size: 0.8 + _rng.nextDouble() * 0.6,
        ),
      );
    }
  }

  /// The thought bubble above the adolescent (4 s, then fades out).
  void _showThought(String key) {
    final gen = ++_thoughtGen;
    setState(() {
      _scene.thoughtKey = key;
      _scene.thoughtShown = false;
    });
    _lab.after(const Duration(milliseconds: 50), () {
      if (gen == _thoughtGen) setState(() => _scene.thoughtShown = true);
    });
    _lab.after(const Duration(milliseconds: 4000), () {
      if (gen == _thoughtGen) setState(() => _scene.thoughtShown = false);
    });
    _lab.after(const Duration(milliseconds: 4500), () {
      if (gen == _thoughtGen) setState(() => _scene.thoughtKey = null);
    });
  }

  // ----------------------------------------------------- scenario 1

  _Activity? get _expectedActivity => _scenario == 0 && _step >= 1 && _step <= 3 ? _activityOrder[_step - 1] : null;

  /// The HTML pointerdown checks: `null` when [a] may be used now, an empty
  /// string to ignore the touch silently, otherwise the reason to show.
  String? _activityBlock(_Activity a) {
    if (_scenario != 0 || _scene.animating) return '';
    final want = _expectedActivity;
    if (want == null) return '';
    if (a != want) return labFormat(_t('msg_wrong_icon'), {'name': _t(_activityKey[want]!)});
    if (_step == 3 && _scene.resetVisible) return _t('msg_reset_first');
    return null;
  }

  bool _canUse(_Activity a) => _activityBlock(a) == null;

  void _rejectActivity(_Activity a) {
    final why = _activityBlock(a);
    if (why == null || why.isEmpty) return;
    _lab.showToast(why, isError: true);
  }

  /// HTML `handleS1Drop()`. [at] is the drop point in design px.
  void _dropActivity(_Activity a, {Offset? at}) {
    if (!_canUse(a)) {
      _rejectActivity(a);
      return;
    }
    final sc = _scene;
    final head = _avatar[sc.mood]!.head;
    _Audio.play(_Sound.correct);
    setState(() {
      sc.animating = true;
      sc.dragging = null;
      sc.rings.add(_Ring(at ?? head, sc.time, _activityColor[a]!));
      switch (a) {
        case _Activity.music:
          sc.mood = _Mood.neutral;
          final h = _avatar[_Mood.neutral]!.head;
          for (var i = 0; i < 3; i++) {
            sc.notes.add(
              _Note(
                h + Offset(-70 + i * 70 + (_rng.nextDouble() - 0.5) * 30, -20 + (_rng.nextDouble() - 0.5) * 40),
                sc.time + i * 0.18,
                _rng.nextDouble() * 6,
              ),
            );
          }
        case _Activity.sports:
          sc.mood = _Mood.happy;
        case _Activity.isolate:
          sc.mood = _Mood.verySad;
      }
    });
    switch (a) {
      case _Activity.music:
        _showThought('txt_music_thought');
        _lab.after(const Duration(milliseconds: 1500), () {
          setState(() {
            sc.step++;
            sc.animating = false;
          });
        });
      case _Activity.sports:
        // The music thought no longer fits the new mood.
        _thoughtGen++;
        setState(() => sc.thoughtKey = null);
        _burst(const Offset(0.5, 0.6), 100, const [_Colors.blue500, _Colors.green400]);
        _lab.after(const Duration(milliseconds: 2000), () {
          setState(() {
            sc.step++;
            sc.resetVisible = true;
            sc.animating = false;
          });
        });
      case _Activity.isolate:
        _showThought('txt_isolate_thought');
        _dim.forward(from: 0);
        _lab.after(const Duration(milliseconds: 2000), () {
          setState(() {
            sc.panelVisible = false;
            sc.step++;
            sc.animating = false;
          });
          _conclusionState();
        });
    }
  }

