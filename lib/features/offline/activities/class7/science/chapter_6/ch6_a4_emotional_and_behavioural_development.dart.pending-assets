// ============================================================ PAINTING

/// Music notes and drop rings over the scenario 1 picture (design px).
class _MoodFxPainter extends CustomPainter {
  _MoodFxPainter({required this.scene, required Listenable repaint}) : super(repaint: repaint);

  final _MoodScene scene;

  @override
  void paint(Canvas canvas, Size size) {
    final t = scene.time;
    for (final r in scene.rings) {
      final a = ((t - r.born) / 0.7).clamp(0.0, 1.0);
      if (a >= 1) continue;
      final rad = 20 + 120 * Curves.easeOut.transform(a);
      labGlow(canvas, r.at, rad, r.color, intensity: 0.35 * (1 - a));
      canvas.drawCircle(
        r.at,
        rad,
        Paint()
          ..style = PaintingStyle.stroke
          ..strokeWidth = 2 + 6 * (1 - a)
          ..color = r.color.withValues(alpha: 0.9 * (1 - a)),
      );
    }
    for (final n in scene.notes) {
      final age = t - n.born;
      if (age < 0) continue;
      final life = age / 3.3;
      if (life >= 1) continue;
      final pos = n.start + Offset(math.sin(t * 2 + n.seed) * 16, -48 * age);
      final opacity = (1 - life) * math.min(1.0, age / 0.25);
      _note(canvas, pos, 34, opacity, math.sin(t * 2.5 + n.seed) * 0.18, beamed: n.seed > 3);
    }
  }

  /// A blue eighth note (or a beamed pair) with a light outline.
  void _note(Canvas canvas, Offset c, double h, double opacity, double tilt, {required bool beamed}) {
    canvas.save();
    canvas.translate(c.dx, c.dy);
    canvas.rotate(tilt);
    var shape = (Path()..addOval(Rect.fromCenter(center: Offset.zero, width: 0.5 * h, height: 0.34 * h))).transform(
      Matrix4.rotationZ(-0.4).storage,
    );
    shape = Path.combine(
      PathOperation.union,
      shape,
      Path()..addRect(Rect.fromLTWH(0.17 * h, -1.0 * h, 0.075 * h, 1.0 * h)),
    );
    if (beamed) {
      final second = shape.shift(Offset(0.55 * h, -0.12 * h));
      shape = Path.combine(PathOperation.union, shape, second);
      shape = Path.combine(
        PathOperation.union,
        shape,
        Path()
          ..moveTo(0.17 * h, -1.0 * h)
          ..lineTo(0.795 * h, -1.12 * h)
          ..lineTo(0.795 * h, -0.95 * h)
          ..lineTo(0.17 * h, -0.83 * h)
          ..close(),
      );
    } else {
      shape = Path.combine(
        PathOperation.union,
        shape,
        Path()
          ..moveTo(0.17 * h, -1.0 * h)
          ..cubicTo(0.42 * h, -0.86 * h, 0.62 * h, -0.7 * h, 0.5 * h, -0.42 * h)
          ..cubicTo(0.47 * h, -0.62 * h, 0.36 * h, -0.7 * h, 0.2 * h, -0.74 * h)
          ..close(),
      );
    }
    canvas.drawPath(
      shape,
      Paint()
        ..style = PaintingStyle.stroke
        ..strokeWidth = 4
        ..strokeJoin = StrokeJoin.round
        ..color = Colors.white.withValues(alpha: 0.85 * opacity),
    );
    canvas.drawPath(shape, Paint()..color = _Colors.blue500.withValues(alpha: opacity));
    canvas.restore();
  }

  @override
  bool shouldRepaint(covariant _MoodFxPainter old) => false;
}

