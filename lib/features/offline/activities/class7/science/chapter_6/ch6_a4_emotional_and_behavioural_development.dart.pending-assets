  // ----------------------------------------------------- scenario 2

  _Reaction? get _expectedReaction => _scenario == 1 && _step >= 1 && _step <= 3 ? _reactionOrder[_step - 1] : null;

  /// HTML `handleS2Choice()`.
  void _handleS2Choice(_Reaction r) {
    final sc = _scene;
    if (sc.blocked) {
      if (sc.tryAltVisible) _lab.showToast(_t('msg_try_alt_first'), isError: true);
      return;
    }
    final want = _expectedReaction;
    if (want == null) return;
    if (r != want) {
      _lab.showToast(labFormat(_t('msg_wrong_reaction'), {'name': _t(_reactionKey[want]!)}), isError: true);
      return;
    }
    _Audio.play(_Sound.click);
    switch (r) {
      case _Reaction.retaliate:
        setState(() {
          sc.blocked = true;
          sc.face = _Face.angry;
        });
        for (var i = 0; i < 3; i++) {
          _lab.after(Duration(milliseconds: i * 300), () {
            setState(() => sc.angryCount++);
            _Audio.play(_Sound.buzz);
            _scrollFeedToEnd();
          });
        }
        _lab.after(const Duration(milliseconds: 1500), () {
          setState(() {
            sc.tryAltVisible = true;
            sc.step++;
          });
        });
      case _Reaction.ignore:
        setState(() {
          sc.blocked = true;
          sc.face = _Face.neutral;
          sc.mean = _MeanState.fading;
        });
        _lab.after(const Duration(milliseconds: 1000), () {
          setState(() {
            sc.mean = _MeanState.gone;
            sc.tryAltVisible = true;
            sc.step++;
          });
        });
      case _Reaction.adult:
        setState(() {
          sc.blocked = true;
          sc.face = _Face.happy;
          sc.adultVisible = true;
          sc.adultIn = false;
        });
        _lab.after(const Duration(milliseconds: 100), () => setState(() => sc.adultIn = true));
        _lab.after(const Duration(milliseconds: 900), () {
          setState(() => sc.mean = _MeanState.exploding);
          _Audio.play(_Sound.magic);
        });
        _lab.after(const Duration(milliseconds: 1500), () => setState(() => sc.adultIn = false));
        _lab.after(const Duration(milliseconds: 2000), () {
          setState(() {
            sc.adultVisible = false;
            sc.step++;
          });
          _conclusionState();
        });
    }
  }

  /// HTML `resetS2Feed()` ("Try Alternative").
  void _resetS2Feed() {
    if (!_scene.tryAltVisible) return;
    _Audio.play(_Sound.click);
    setState(_scene.resetFeed);
    _scrollFeedToEnd();
  }

  void _scrollFeedToEnd() {
    WidgetsBinding.instance.addPostFrameCallback((_) {
