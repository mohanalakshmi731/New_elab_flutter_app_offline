  /// Bubble beside the head (right side unless the activity panel leaves
  /// too little room) plus two small "thought" dots.
  List<Widget> _thoughtBubble(double s, Size size, EdgeInsets inset, Offset head, double k) {
    final dark = _lab.isDark;
    final shown = _scene.thoughtShown;
    // The bubble's lower corner sits beside the head, clear of the label.
    final gap = math.max(100 * k, 64 * s);
    final panelLeft = _scene.panelVisible ? size.width - inset.right - 10 - 100 * s : size.width - inset.right;
    final rightRoom = panelLeft - 8 - (head.dx + gap);
    final leftRoom = head.dx - gap - inset.left - 8;
    final maxW = 230 * s;
    final onRight = rightRoom >= math.min(maxW, 150 * s) || rightRoom >= leftRoom;
    final width = math.max(math.min(maxW, onRight ? rightRoom : leftRoom), 96 * s);
    final corner = Offset(onRight ? head.dx + gap : head.dx - gap, math.max(head.dy - 60 * k, inset.top + 54 * s));
    final from = head + Offset(onRight ? 50 * k : -50 * k, -22 * k);
    final fill = dark ? _Colors.slate800 : Colors.white;
    final edge = dark ? _Colors.blue600 : _Colors.blue300;

    Widget fade(Widget child) => AnimatedOpacity(
      opacity: shown ? 1 : 0,
      duration: const Duration(milliseconds: 500),
      child: AnimatedSlide(
        offset: shown ? Offset.zero : const Offset(0, 0.25),
        duration: const Duration(milliseconds: 500),
        curve: Curves.easeOut,
        child: child,
      ),
    );

    Widget dot(String id, double t, double r) {
      final c = Offset.lerp(from, corner, t)!;
      return Positioned(
        key: ValueKey(id),
        left: c.dx - r,
        top: c.dy - r,
        child: fade(
          Container(
            width: r * 2,
            height: r * 2,
            decoration: BoxDecoration(
              shape: BoxShape.circle,
              color: fill,
              border: Border.all(color: edge, width: 2),
            ),
          ),
        ),
      );
    }

    final big = Radius.circular(22 * s);
    final small = Radius.circular(4 * s);
    return [
      dot('dot1', 0.25, 4 * s),
      dot('dot2', 0.62, 6.5 * s),
      Positioned(
        key: const ValueKey('bubble'),
        left: onRight ? corner.dx : null,
        right: onRight ? null : size.width - corner.dx,
        bottom: size.height - corner.dy,
        child: fade(
          Container(
            constraints: BoxConstraints(maxWidth: width),
            padding: EdgeInsets.symmetric(horizontal: 14 * s, vertical: 9 * s),
            decoration: BoxDecoration(
              color: fill,
              borderRadius: BorderRadius.only(
                topLeft: big,
                topRight: big,
                bottomLeft: onRight ? small : big,
                bottomRight: onRight ? big : small,
              ),
              border: Border.all(color: edge, width: 2),
              boxShadow: const [BoxShadow(color: Color(0x59000000), blurRadius: 24, offset: Offset(0, 10))],
            ),
            child: Text(
              _t(_scene.thoughtKey!),
              textAlign: TextAlign.center,
              style: TextStyle(
                color: dark ? _Colors.blue400 : _Colors.blue600,
                fontWeight: FontWeight.w800,
                fontSize: 13 * s,
                height: 1.3,
              ),
            ),
          ),
        ),
      ),
    ];
  }

